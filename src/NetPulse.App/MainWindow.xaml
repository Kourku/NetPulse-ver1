<Window x:Class="NetPulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetPulse.App.ViewModels"
        xmlns:controls="clr-namespace:NetPulse.App.Controls"
        mc:Ignorable="d"
        Title="NetPulse - Real-Time Network Quality &amp; Path Diagnostics"
        Height="780" Width="1200" MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="64" />
            <!-- Main Content with Tabs -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ==================================================== -->
        <!-- Top App Bar -->
        <!-- ==================================================== -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentBlueBrush}" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NetPulse" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="PRO" FontWeight="Bold" FontSize="10" Foreground="{StaticResource AccentBlueBrush}" Margin="6,2,0,0" VerticalAlignment="Top" />
                        </StackPanel>
                        <TextBlock Text="Network Quality &amp; Path Diagnostics" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Center Active Interface Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="16" Padding="14,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveNic.Name, FallbackValue='Detecting...'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ActiveNic.SpeedDisplay, FallbackValue=''}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text=" • Gateway: " Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0" />
                            <TextBlock Text="{Binding ActiveNic.Ipv4Gateway, FallbackValue='Searching'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBlueBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Actions: Mode Toggle & Export -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Beginner / Advanced Mode Toggle -->
                    <Border Background="#1E293B" CornerRadius="6" Padding="3" Margin="0,0,12,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Beginner" Padding="10,4" FontSize="11"
                                    Background="{Binding IsBeginnerMode, Converter={x:Null}}"
                                    Command="{Binding ToggleModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBeginnerMode}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Advanced" Padding="10,4" FontSize="11"
                                    Command="{Binding ToggleModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBeginnerMode}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Export Report Button -->
                    <Button Content="Export Report" Style="{StaticResource OutlineButton}" Padding="12,6" FontSize="12"
                            Command="{Binding ExportReportCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================== -->
        <!-- Main Content Area with Navigation Sidebar -->
        <!-- ==================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel>
                    <TextBlock Text="MONITORING" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="10,0,0,8" />
                    
                    <RadioButton Content="📊 Overview" Style="{StaticResource NavTabButton}" IsChecked="True"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Dashboard" Margin="0,2" />
                    
                    <RadioButton Content="📡 Targets &amp; Probes" Style="{StaticResource NavTabButton}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Monitoring" Margin="0,2" />
                    
                    <RadioButton Content="🗺️ Route &amp; MTR" Style="{StaticResource NavTabButton}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="RoutePath" Margin="0,2" />

                    <TextBlock Text="DIAGNOSTIC TOOLS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="10,18,0,8" />

                    <RadioButton Content="⚖️ Bufferbloat Test" Style="{StaticResource NavTabButton}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Bufferbloat" Margin="0,2" />

                    <RadioButton Content="🚀 Speed &amp; Bandwidth" Style="{StaticResource NavTabButton}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="SpeedTest" Margin="0,2" />

                    <TextBlock Text="SYSTEM &amp; LOGS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="10,18,0,8" />

                    <RadioButton Content="🖧 Adapter &amp; Wi-Fi" Style="{StaticResource NavTabButton}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Adapter" Margin="0,2" />

                    <RadioButton Content="📜 Event Timeline" Style="{StaticResource NavTabButton}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Events" Margin="0,2" />

                    <RadioButton Content="💾 Data &amp; Export" Style="{StaticResource NavTabButton}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Export" Margin="0,2" />
                </StackPanel>
            </Border>

            <!-- Tab Content Switcher -->
            <Grid Grid.Column="1" Margin="24,20,24,20">

                <!-- TAB 1: OVERVIEW / DASHBOARD -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="Dashboard">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Big Diagnostic Status Banner -->
                        <Border CornerRadius="10" Padding="20,16" Margin="0,0,0,20" BorderThickness="1"
                                Background="#111827" BorderBrush="{Binding StatusBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="{Binding StatusBrush}" Margin="0,0,16,0">
                                    <TextBlock Text="●" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="CONNECTION STATUS: " FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding StatusCategory}" FontWeight="Bold" FontSize="12" Foreground="{Binding StatusBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusHeadline}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LikelyCause}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="14,10" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Recommended Action" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding RecommendedAction}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" MaxWidth="260" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Metric Cards Grid -->
                        <UniformGrid Columns="4" Margin="0,0,0,20">
                            <!-- Card 1: Internet Latency -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                        <TextBlock Text="Internet Latency" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text=" ℹ" ToolTip="How long it takes for data to travel to Internet servers and return. Lower is better." Foreground="#64748B" Cursor="Help" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="{Binding QuickInternetLatency, StringFormat='{}{0:F1}'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text=" ms" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                                    </StackPanel>
                                    <TextBlock Text="Global Anycast Average" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Jitter -->
                            <Border Style="{StaticResource CardPanel}" Margin="8,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Jitter (Stability)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text=" ℹ" ToolTip="RFC 3550 statistical variation in consecutive latency probes. Low jitter (&lt;5ms) is vital for gaming and calls." Foreground="#64748B" Cursor="Help" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="{Binding QuickJitter, StringFormat='{}{0:F1}'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text=" ms" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                                    </StackPanel>
                                    <TextBlock Text="Interarrival Variation" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Packet Loss -->
                            <Border Style="{StaticResource CardPanel}" Margin="8,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Packet Loss" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text=" ℹ" ToolTip="Percentage of packets dropped or unanswered. Even 1-2% loss causes noticeable stutter and disconnects." Foreground="#64748B" Cursor="Help" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="{Binding QuickPacketLoss, StringFormat='{}{0:F1}'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text=" %" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                                    </StackPanel>
                                    <TextBlock Text="End-to-End Reliability" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Local Gateway -->
                            <Border Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Local Gateway / Router" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text=" ℹ" ToolTip="Roundtrip latency between this PC and your home router. Should be &lt;1ms on Ethernet or &lt;5ms on Wi-Fi." Foreground="#64748B" Cursor="Help" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="{Binding QuickGatewayLatency, StringFormat='{}{0:F1}'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text=" ms" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                                    </StackPanel>
                                    <TextBlock Text="Hop 1 First Mile Latency" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Network Path Chain Visualization -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="NETWORK HEALTH CHAIN" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Step 1: PC -->
                                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="12,10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="💻 This PC" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding ActiveNic.Ipv4Address}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            <TextBlock Text="Adapter: UP" FontSize="10" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />

                                    <!-- Step 2: Home Router -->
                                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="12,10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📶 Home Router" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding ActiveNic.Ipv4Gateway}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding QuickGatewayLatency, StringFormat='{}{0:F1} ms'}" FontSize="10" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="3" Text="→" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />

                                    <!-- Step 3: ISP & Internet -->
                                    <Border Grid.Column="4" Background="#1E293B" CornerRadius="8" Padding="12,10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🌐 ISP / Internet" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Backbone Anycast" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding QuickInternetLatency, StringFormat='{}{0:F1} ms'}" FontSize="10" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="5" Text="→" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />

                                    <!-- Step 4: DNS -->
                                    <Border Grid.Column="6" Background="#1E293B" CornerRadius="8" Padding="12,10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🔍 DNS Resolver" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Name Resolution" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding QuickDnsLatency, StringFormat='{}{0:F1} ms'}" FontSize="10" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostic Evidence Details -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="MEASURED EVIDENCE &amp; DIAGNOSTIC INTERPRETATION" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding EvidenceSummary}" FontSize="13" LineHeight="20" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: TARGETS & MONITORING -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Monitoring">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Multi-Target Continuous Monitoring" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Probing independent, operationally diverse endpoints via ICMP, TCP, HTTPS, and DNS." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Targets}">
                        <DataGrid.Columns>
                            <!-- Target Name -->
                            <DataGridTemplateColumn Header="Target Endpoint" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding TargetHost}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Protocol -->
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80" />

                            <!-- Current RTT -->
                            <DataGridTemplateColumn Header="Latency" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LatencyDisplay}" FontWeight="Bold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Rolling Avg -->
                            <DataGridTextColumn Header="Rolling Avg" Binding="{Binding AvgDisplay}" Width="90" />

                            <!-- Min / Max -->
                            <DataGridTemplateColumn Header="Min / Max" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MinLatency, StringFormat='{}{0:F0} / '}" Foreground="{StaticResource TextSecondaryBrush}">
                                            <TextBlock.Inlines>
                                                <Run Text="{Binding MaxLatency, StringFormat='{}{0:F0} ms', Mode=OneWay}" />
                                            </TextBlock.Inlines>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Jitter -->
                            <DataGridTextColumn Header="Jitter (RFC3550)" Binding="{Binding JitterDisplay}" Width="110" />

                            <!-- Packet Loss -->
                            <DataGridTextColumn Header="Loss %" Binding="{Binding LossDisplay}" Width="80" />

                            <!-- Sparkline Chart -->
                            <DataGridTemplateColumn Header="Real-time History" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:SparklineChart Values="{Binding ChartValues}" LineBrush="{Binding StatusBrush}" Height="28" Margin="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- TAB 3: ROUTE & MTR -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="RoutePath">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Hop-by-Hop Path Discovery &amp; Continuous MTR" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Analyzes every router hop along the path to determine where latency or packet loss begins." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- MTR Target Input Bar -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Target Destination:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding MtrDestination, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderBrush}" Padding="8,4" VerticalAlignment="Center" />

                            <Button Grid.Column="2" Content="Start MTR Trace" Command="{Binding StartMtrCommand}" Margin="10,0,6,0" />
                            <Button Grid.Column="3" Content="Stop" Style="{StaticResource OutlineButton}" Command="{Binding StopMtrCommand}" />

                            <TextBlock Grid.Column="4" Text="{Binding MtrStatusText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
                        </Grid>
                    </Border>

                    <!-- MTR Hops Table -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding MtrHops}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hop" Binding="{Binding HopNumber}" Width="50" />
                            <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="140" />
                            <DataGridTextColumn Header="Hostname / rDNS" Binding="{Binding DisplayHost}" Width="200" />
                            <DataGridTextColumn Header="Current (ms)" Binding="{Binding CurrentRttMs, StringFormat='{}{0:F1}'}" Width="90" />
                            <DataGridTextColumn Header="Avg (ms)" Binding="{Binding AvgRttMs, StringFormat='{}{0:F1}'}" Width="80" />
                            <DataGridTextColumn Header="Best (ms)" Binding="{Binding MinRttMs, StringFormat='{}{0:F1}'}" Width="80" />
                            <DataGridTextColumn Header="Worst (ms)" Binding="{Binding MaxRttMs, StringFormat='{}{0:F1}'}" Width="80" />
                            <DataGridTextColumn Header="Loss %" Binding="{Binding LossPercent, StringFormat='{}{0:F0}%'}" Width="70" />
                            <DataGridTextColumn Header="ASN / Organization" Binding="{Binding AsDisplay}" Width="160" />
                            <DataGridTemplateColumn Header="Diagnostics" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚠️ Sustained Jump" Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold"
                                                       Visibility="{Binding IsPersistentLatencyIncrease, Converter={x:Null}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPersistentLatencyIncrease}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Route Anomalies & Path Comparison -->
                    <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Route Anomalies -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ROUTE ANOMALIES &amp; HOP ANALYSIS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding RouteAnomalies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="16,0" />

                            <!-- Right: Path Comparison Tool -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COMPARE DESTINATIONS (DIVERGENCE ANALYSIS)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBox Text="{Binding PathCompareDestA}" Width="90" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderBrush}" Padding="4,2" />
                                    <TextBlock Text=" vs " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0" />
                                    <TextBox Text="{Binding PathCompareDestB}" Width="90" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderBrush}" Padding="4,2" />
                                    <Button Content="Compare" Command="{Binding ComparePathsCommand}" Margin="8,0,0,0" Padding="8,4" FontSize="11" />
                                </StackPanel>
                                <TextBlock Text="{Binding PathCompareSummary}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 4: BUFFERBLOAT TEST -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Bufferbloat">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <TextBlock Text="Bufferbloat &amp; Latency Under Load Test" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Measures ping increase during bandwidth saturation to detect queue bloat on your home router." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,16" />

                        <!-- Runner Card -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Automated 3-Phase Loaded Latency Evaluation" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Phase 1: Baseline Ping → Phase 2: Ping during Download → Phase 3: Ping during Upload" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Start Bufferbloat Test" Command="{Binding RunBufferbloatCommand}"
                                            IsEnabled="{Binding IsBufferbloatRunning, Converter={x:Null}}" Padding="16,8" />
                                </Grid>

                                <ProgressBar Height="8" Value="{Binding BufferbloatProgress}" Maximum="100" Margin="0,14,0,6" Background="#1E293B" Foreground="{StaticResource AccentBlueBrush}" />
                                <TextBlock Text="{Binding BufferbloatStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Results Card (if completed) -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Grade Circle -->
                                <Border Grid.Column="0" Width="100" Height="100" CornerRadius="50" Background="#1E293B" BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LatestBufferbloatResult.Grade, FallbackValue='A+'}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="GRADE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <TextBlock Text="{Binding LatestBufferbloatResult.Summary, FallbackValue='Run a test to assess your connection under heavy load.'}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LatestBufferbloatResult.Explanation, FallbackValue='Bufferbloat happens when routers buffer too many packets during downloads/uploads, causing huge latency spikes.'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />

                                    <UniformGrid Columns="3" Margin="0,14,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Baseline Latency" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding LatestBufferbloatResult.BaselineLatencyMs, StringFormat='{}{0:F1} ms', FallbackValue='--'}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Download Loaded Latency" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding LatestBufferbloatResult.DownloadLoadedLatencyMs, StringFormat='{}{0:F1} ms', FallbackValue='--'}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentAmberBrush}" />
                                            <TextBlock Text="{Binding LatestBufferbloatResult.DownloadDeltaMs, StringFormat='{}(+{0:F1} ms delta)', FallbackValue=''}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Upload Loaded Latency" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding LatestBufferbloatResult.UploadLoadedLatencyMs, StringFormat='{}{0:F1} ms', FallbackValue='--'}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentAmberBrush}" />
                                            <TextBlock Text="{Binding LatestBufferbloatResult.UploadDeltaMs, StringFormat='{}(+{0:F1} ms delta)', FallbackValue=''}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <Border Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding LatestBufferbloatResult.Recommendation, StringFormat='Recommendation: {0}', FallbackValue='Recommendation: Run test to evaluate.'}" FontSize="12" Foreground="{StaticResource AccentGreenBrush}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 5: SPEED TEST -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="SpeedTest">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <TextBlock Text="Bandwidth &amp; Throughput Measurement" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Multi-stream download and upload benchmark against high-speed CDN edge nodes." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,16" />

                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="⚠️ Bandwidth Warning" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentAmberBrush}" />
                                        <TextBlock Text="This test transfers large volumes of data for ~10 seconds. Do not run continuously." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Run Speed Test" Command="{Binding RunSpeedTestCommand}"
                                            IsEnabled="{Binding IsSpeedTestRunning, Converter={x:Null}}" Padding="16,8" />
                                </Grid>

                                <ProgressBar Height="8" Value="{Binding SpeedTestProgress}" Maximum="100" Margin="0,14,0,6" Background="#1E293B" Foreground="{StaticResource AccentGreenBrush}" />
                                <TextBlock Text="{Binding SpeedTestStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,0,0,20">
                            <!-- Download Speed Card -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center" Margin="0,10">
                                    <TextBlock Text="DOWNLOAD THROUGHPUT" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,4">
                                        <TextBlock Text="{Binding LatestSpeedTestResult.DownloadSpeedMbps, StringFormat='{}{0:F1}', FallbackValue='--'}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" />
                                        <TextBlock Text=" Mbps" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,8" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LatestSpeedTestResult.BytesDownloaded, StringFormat='Transferred: {0:N0} bytes', FallbackValue=''}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Upload Speed Card -->
                            <Border Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                                <StackPanel HorizontalAlignment="Center" Margin="0,10">
                                    <TextBlock Text="UPLOAD THROUGHPUT" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,4">
                                        <TextBlock Text="{Binding LatestSpeedTestResult.UploadSpeedMbps, StringFormat='{}{0:F1}', FallbackValue='--'}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" />
                                        <TextBlock Text=" Mbps" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,8" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LatestSpeedTestResult.BytesUploaded, StringFormat='Transferred: {0:N0} bytes', FallbackValue=''}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 6: ADAPTER & WI-FI -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Adapter">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <TextBlock Text="Active Network Adapter &amp; Interface" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Hardware link status, addressing, and Windows wireless radio details." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,16" />

                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="HARDWARE INTERFACE" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding ActiveNic.Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding ActiveNic.Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,10" />

                                    <TextBlock Text="Type:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ActiveNic.InterfaceType}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                    <TextBlock Text="Link Speed:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ActiveNic.SpeedDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,8" />

                                    <TextBlock Text="Operational Status:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ActiveNic.OperationalStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="IP &amp; ROUTING CONFIGURATION" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                                    <TextBlock Text="IPv4 Address:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ActiveNic.Ipv4Address}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                    <TextBlock Text="IPv4 Subnet Mask:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ActiveNic.Ipv4Subnet}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                    <TextBlock Text="IPv4 Default Gateway:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ActiveNic.Ipv4Gateway}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,8" />

                                    <TextBlock Text="Configured DNS Servers:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding ActiveNic.DnsServers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Wi-Fi Specific Card -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="WI-FI WIRELESS RADIO INFORMATION" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                                <UniformGrid Columns="4">
                                    <StackPanel>
                                        <TextBlock Text="SSID (Network)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiSsid, FallbackValue='Not Connected'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Signal Strength" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiSignalPercent, StringFormat='{}{0}%', FallbackValue='N/A'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Radio Protocol" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiRadioType, FallbackValue='N/A'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Channel" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiChannel, FallbackValue='N/A'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 7: EVENT TIMELINE -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Events">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Connection Event Timeline" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Chronological record of latency spikes, loss bursts, route transitions, and outages." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear Log" Style="{StaticResource OutlineButton}" Command="{Binding ClearEventsCommand}" VerticalAlignment="Center" />
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Events}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="110" />
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                            <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="130" />
                            <DataGridTextColumn Header="Target / Scope" Binding="{Binding TargetName}" Width="150" />
                            <DataGridTextColumn Header="Description &amp; Measured Context" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- TAB 8: EXPORT & REPORTS -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Export">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <TextBlock Text="Data Recording &amp; Diagnostic Export" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Export session data locally without cloud telemetry or external accounts." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,16" />

                        <!-- Export Card 1: Diagnostic Report -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Comprehensive Diagnostic Report (Markdown / Plain Text)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Formatted technical document detailing network configuration, gateway stats, target metrics, route path hops, bufferbloat results, and event logs. Ready to submit to your ISP or network technician." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Export Report (.md)" Command="{Binding ExportReportCommand}" Padding="16,8" VerticalAlignment="Center" Margin="16,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- Export Card 2: CSV Measurements -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Raw Measurement Log (CSV)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Detailed per-second probe records including high-resolution RTT, timestamps, protocol (ICMP/TCP/HTTPS/DNS), resolved IPs, and HTTPS timing breakdown." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Export CSV (.csv)" Command="{Binding ExportCsvCommand}" Style="{StaticResource OutlineButton}" Padding="16,8" VerticalAlignment="Center" Margin="16,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- Export Card 3: JSON Diagnostic Snapshot -->
                        <Border Style="{StaticResource CardPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Diagnostic Snapshot (JSON)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Machine-readable structured JSON snapshot containing the current state, active network interface, rolling statistics, route history, and recent events." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Export JSON (.json)" Command="{Binding ExportJsonCommand}" Style="{StaticResource OutlineButton}" Padding="16,8" VerticalAlignment="Center" Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>

        <!-- ==================================================== -->
        <!-- Bottom Status Bar -->
        <!-- ==================================================== -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Monitoring Engine: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="ACTIVE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentGreenBrush}" />
                    <TextBlock Text=" • 1000ms Probing Interval" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="100% Local • Zero Telemetry • Native Windows .NET" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
