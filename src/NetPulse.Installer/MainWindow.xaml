<Window x:Class="NetPulse.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetPulse Setup"
        Height="420" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0F19"
        Foreground="#F9FAFB">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#3B82F6" Margin="0,0,14,0">
                <TextBlock Text="⚡" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleBlock" Text="NetPulse Diagnostics Setup" FontSize="18" FontWeight="Bold" Foreground="#F9FAFB" />
                <TextBlock x:Name="SubtitleBlock" Text="Version 1.0.0 • Real-Time Network Quality &amp; Path Diagnostics" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Body / Content -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Install View -->
            <StackPanel x:Name="InstallPanel">
                <TextBlock Text="Installation Directory:" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtInstallDir" Background="#1E293B" Foreground="#F9FAFB" BorderBrush="#374151" Padding="10,8" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseClick" Background="#374151" Foreground="White" Padding="12,8" Margin="8,0,0,0" Cursor="Hand" />
                </Grid>

                <StackPanel Margin="0,0,0,16">
                    <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop shortcut" IsChecked="True" Foreground="#F9FAFB" Margin="0,4" />
                    <CheckBox x:Name="ChkStartMenuShortcut" Content="Create Start Menu shortcut" IsChecked="True" Foreground="#F9FAFB" Margin="0,4" />
                    <CheckBox x:Name="ChkLaunchAfter" Content="Launch NetPulse after installation" IsChecked="True" Foreground="#F9FAFB" Margin="0,4" />
                </StackPanel>
            </StackPanel>

            <!-- Uninstall Confirmation View -->
            <StackPanel x:Name="UninstallPanel" Visibility="Collapsed">
                <TextBlock Text="This will remove NetPulse from your system, including desktop and start menu shortcuts."
                           FontSize="13" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,16" />
            </StackPanel>

            <!-- Progress & Status -->
            <StackPanel Margin="0,4,0,0">
                <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#1E293B" Foreground="#3B82F6" Visibility="Collapsed" Margin="0,0,0,6" />
                <TextBlock x:Name="TxtStatus" Text="Ready to install." FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- Bottom Action Buttons -->
        <Border Grid.Row="2" BorderBrush="#2D3748" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnAction" Content="Install" Click="OnActionClick" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" Padding="20,8" FontSize="13" Margin="0,0,10,0" Cursor="Hand" />
                <Button x:Name="BtnCancel" Content="Cancel" Click="OnCancelClick" Background="#1E293B" Foreground="#F9FAFB" Padding="16,8" FontSize="13" Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
